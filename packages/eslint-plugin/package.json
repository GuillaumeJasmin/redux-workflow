{
  "name": "@redux-workflow/eslint-plugin",
  "version": "0.1.0",
  "description": "ESLint rules for @redux-workflow — enforces yield* usage",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "redux-workflow",
    "redux-saga",
    "yield-star"
  ],
  "author": "Guillaume Jasmin",
  "license": "MIT",
  "homepage": "https://github.com/GuillaumeJasmin/redux-workflow#readme",
  "bugs": {
    "url": "https://github.com/GuillaumeJasmin/redux-workflow/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuillaumeJasmin/redux-workflow.git",
    "directory": "packages/eslint-plugin"
  },
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "./configs/recommended": {
      "types": "./dist/configs/recommended.d.cts",
      "default": "./dist/configs/recommended.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint:publint": "publint",
    "lint:attw": "attw --pack . --ignore-rules no-resolution named-exports",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "tsdown": "^0.21.10",
    "vitest": "^2.0.0"
  }
}
