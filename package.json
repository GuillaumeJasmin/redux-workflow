{
  "name": "redux-workflow",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "start": "node start.mts",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:publint": "pnpm -r run lint:publint",
    "lint:attw": "pnpm -r run lint:attw",
    "lint:knip": "knip",
    "lint:publish": "pnpm build && pnpm lint:publint && pnpm lint:attw",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.{ts,tsx,json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.39.4",
    "@inquirer/prompts": "^8.4.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "knip": "^6.7.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "publint": "^0.3.18",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.0"
  }
}
